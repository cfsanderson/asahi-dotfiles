# Oh My Zsh (installed separately via install script)
# Only custom/aliases.zsh is tracked from this directory
zsh/.config/zsh/oh-my-zsh/
# Exception: force-tracked aliases remain tracked despite parent ignore

# Tmux plugins (managed by TPM)
tmux/.tmux/
tmux/.config/tmux/plugins/

# Zsh compiled files
zsh/.config/zsh/.zcompdump*

# Local environment (secrets)
zsh/.config/zsh/.env.local

# MPD runtime files (regenerated by daemon)
mpd/.config/mpd/database
mpd/.config/mpd/state
mpd/.config/mpd/sticker.sql
mpd/.config/mpd/log
mpd/.config/mpd/pid
mpd/.config/mpd/playlists/

# Editor/tool artifacts
.crush/

# aerc accounts (contains PII - email address)
aerc/.config/aerc/accounts.conf

# Local session notes (machine-specific)
CLAUDE.local.md

# Claude Code internal files (worktrees, settings)
.claude/

# systemd --user enablement symlinks (auto-generated machine state, not
# portable config) -- ~/.config/systemd is a whole-directory stow symlink
# into vdirsyncer/.config/systemd, so `systemctl --user enable` for ANY
# service (not just vdirsyncer's own) physically writes its wants-symlink
# here. Keep the actual .service/.timer unit files tracked; ignore the
# enablement symlinks systemctl generates.
vdirsyncer/.config/systemd/user/*.target.wants/
